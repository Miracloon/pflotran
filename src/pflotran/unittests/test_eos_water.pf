module Test_EOS_Water_module

#include "petsc/finclude/petscsys.h"
  use petscsys
  use pFUnit_mod
  use EOS_Water_module

  implicit none

  public :: Test_EOS_Water

  interface Test_EOS_Water
     module procedure newTest_EOS_Water
  end interface Test_EOS_Water

  @TestCase
  type, extends(TestCase) :: Test_EOS_Water
     procedure(runMethod), pointer :: userMethod => null()
   contains
     procedure :: setUp
     procedure :: tearDown
     procedure :: runMethod
  end type Test_EOS_Water

contains

! ************************************************************************** !

  function newTest_EOS_Water(name, userMethod) result(test)

    implicit none

    character(len=*), intent(in) :: name
    procedure(runMethod) :: userMethod

    type(Test_EOS_Water) :: test

    call test%setName(name)
    test%userMethod => userMethod

  end function newTest_EOS_Water

! ************************************************************************** !

  subroutine setUp(this)
    implicit none
    class (Test_EOS_Water), intent(inout) :: this

    call EOSWaterInit()

  end subroutine setUp

! ************************************************************************** !

  subroutine tearDown(this)
    implicit none
    class (Test_EOS_Water), intent(inout) :: this
    ! Destroy calls would go here
  end subroutine tearDown

! ************************************************************************** !

  subroutine runMethod(this)
    implicit none
    class (Test_EOS_Water), intent(inout) :: this
    call this%userMethod()
  end subroutine runMethod

! ************************************************************************** !

  @Test
  subroutine testEOSWater_VerifyDefault(this)
    !
    ! verify that the default from EOSWaterInit passes the verify
    ! test.
    !
    use PFLOTRAN_Constants_module, only : MAXSTRINGLENGTH

    implicit none

    class (Test_EOS_Water), intent(inout) :: this

    PetscErrorCode :: ierr
    character(len=MAXSTRINGLENGTH) :: error_string

    call EOSWaterVerify(ierr, error_string)
    @assertEqual(0, ierr)

  end subroutine testEOSWater_VerifyDefault

! ************************************************************************** !

  @Test
  subroutine testEOSWater_ConstantDensity(this)
    !
    ! verify that the EOSWaterSetDensityConstant() followed by
    ! EOSWaterDensity() correctly returns the constant density
    !
    use PFLOTRAN_Constants_module, only : MAXSTRINGLENGTH

    implicit none

    class (Test_EOS_Water), intent(inout) :: this

    PetscErrorCode :: ierr
    character(len=MAXSTRINGLENGTH) :: error_string

    PetscReal, parameter :: density = 1234.5d0
    PetscReal, parameter :: temperature = -23.4d0
    PetscReal, parameter :: pressure = 1.0d0
    PetscReal :: aux(1)
    PetscReal :: dw, dwmol, dwp, dwt

    call EOSWaterInit()

    aux(1) = density
    call EOSWaterSetDensity('CONSTANT',aux)

    call EOSWaterVerify(ierr, error_string)
    @assertEqual(0, ierr)

    call EOSWaterDensity(temperature, pressure, dw, dwmol, &
         dwp, dwt, ierr)
    @assertEqual(density, dw, 1.0d-16)

  end subroutine testEOSWater_ConstantDensity

! ************************************************************************** !

  @Test
  subroutine testEOSWater_DensitySTP(this)
    !
    ! verify that EOSWaterDensity returns the correct density at
    ! NIST standard temperature and pressure (20C, 101.325 kPa absolute)
    !
    use PFLOTRAN_Constants_module, only : MAXSTRINGLENGTH

    implicit none

    class (Test_EOS_Water), intent(inout) :: this

    PetscErrorCode :: ierr

    PetscReal, parameter :: temperature = 20.0d0
    PetscReal, parameter :: pressure = 101325.0d0
    PetscReal :: density
    PetscReal :: saturation_pressure
    PetscReal :: viscosity
    PetscReal :: dum1
    PetscReal :: value

    call EOSWaterInit()

    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    value = 998.32340486329440d0
    @assertEqual(value, density,  1.0d-16)

    call EOSWaterSaturationPressure(temperature, saturation_pressure, ierr)
    value = 2330.6458955821176d0
    @assertEqual(value, saturation_pressure,  1.0d-16)

    call EOSWaterViscosity(temperature, pressure, saturation_pressure, &
                           viscosity, ierr)
    value = 1.0017364592757613d-003
    @assertEqual(value, viscosity,  1.0d-16)

  end subroutine testEOSWater_DensitySTP

! ************************************************************************** !

  @Test
  subroutine testEOSWater_BatzleAndWang(this)
    !
    ! verify that the EOSWaterSetXXX('BATZLE_AND_WANG') followed by
    ! EOSWaterXXX() correctly returns the correct values
    !
    use PFLOTRAN_Constants_module, only : MAXSTRINGLENGTH

    implicit none

    class (Test_EOS_Water), intent(inout) :: this

    PetscErrorCode :: ierr
    character(len=MAXSTRINGLENGTH) :: error_string

    PetscReal :: temperature
    PetscReal :: pressure
    PetscReal :: saturation_pressure
    PetscReal :: dsaturation_pressure
    PetscReal :: dw, dwmol, dwp, dwt, vw
    PetscReal :: value

    call EOSWaterInit()

    call EOSWaterSetDensity('BATZLE_AND_WANG')
    call EOSWaterSetViscosity('BATZLE_AND_WANG')

    call EOSWaterVerify(ierr, error_string)
    @assertEqual(0, ierr)

    temperature = 20.d0
    pressure = 101325.d0
    saturation_pressure = 0.d0
    dsaturation_pressure = 0.d0

    call EOSWaterDensity(temperature, pressure, dw, dwmol, &
         dwp, dwt, ierr)

    value = 0.99714012903770011d3
    @assertEqual(value, dw, 1.0d-16)
!    value = 4.5522041154999997d-001
    value = 2.5268488496470232d-008
    @assertEqual(value, dwp, 1.0d-16)
    value = -1.1658919743036282d-002
    @assertEqual(value, dwt, 1.0d-16)

    saturation_pressure = 0.d0
    call EOSWaterViscosity(temperature, pressure, saturation_pressure, &
                           vw, ierr)
    value = 0.98080392683703244d-3
    @assertEqual(value, vw,  1.0d-16)

  end subroutine testEOSWater_BatzleAndWang

! ************************************************************************** !

  @Test
  subroutine testEOSWater_BatzleAndWangExt(this)
    !
    ! verify that the EOSWaterSetXXX('BATZLE_AND_WANG') followed by
    ! EOSWaterXXX() correctly returns the correct values
    !
    use PFLOTRAN_Constants_module, only : MAXSTRINGLENGTH

    implicit none

    class (Test_EOS_Water), intent(inout) :: this

    PetscErrorCode :: ierr
    character(len=MAXSTRINGLENGTH) :: error_string

    PetscReal :: temperature
    PetscReal :: pressure
    PetscReal :: saturation_pressure
    PetscReal :: dsaturation_pressure
    PetscReal :: aux(1)
    PetscReal :: dw, dwmol, dwp, dwt, vw
    PetscReal :: value

    call EOSWaterInit()

    call EOSWaterSetDensity('BATZLE_AND_WANG')
    call EOSWaterSetViscosity('BATZLE_AND_WANG')

    call EOSWaterVerify(ierr, error_string)
    @assertEqual(0, ierr)

    temperature = 20.d0
    pressure = 101325.d0
    saturation_pressure = 0.d0
    dsaturation_pressure = 0.d0

    aux(1) = 0.14d0
    call EOSWaterDensityExt(temperature, pressure, aux, dw, dwmol, &
         dwp, dwt, ierr)

    value = 1.0983801969415001d3
    @assertEqual(value, dw, 1.0d-16)
    value = 2.3990910610068976d-008
    @assertEqual(value, dwp, 1.0d-16)
    value = -1.3700017546907872d-002
    @assertEqual(value, dwt, 1.0d-16)

    saturation_pressure = 0.d0
    call EOSWaterViscosityExt(temperature, pressure, saturation_pressure, aux, &
                           vw, ierr)
    value = 1.2993992003751142d-003
    @assertEqual(value, vw,  1.0d-16)

  end subroutine testEOSWater_BatzleAndWangExt

! ************************************************************************** !

  @Test
  subroutine testEOSWater_SatPresWagnerPruss(this)
    !
    ! verify that the EOSWaterSatPresWagnerPruss returns the correct values
    !
    use PFLOTRAN_Constants_module, only : MAXSTRINGLENGTH

    implicit none

    class (Test_EOS_Water), intent(inout) :: this

    PetscErrorCode :: ierr

    PetscReal :: temperature
    PetscReal :: saturation_pressure
    PetscReal :: dsaturation_pressure
    PetscReal :: value

    call EOSWaterInit()
    call EOSWaterSetSaturationPressure('WAGNER_AND_PRUSS')

    temperature = 0.d0
    saturation_pressure = 0.d0
    dsaturation_pressure = 0.d0

    call EOSWaterSaturationPressure(temperature, saturation_pressure, ierr)
    value = 611.21284593985558d0
    @assertEqual(value, saturation_pressure, 1.0d-16)

    temperature = 100.d0
    call EOSWaterSaturationPressure(temperature, saturation_pressure, ierr)
    value = 101417.99381792783d0
    @assertEqual(value, saturation_pressure, 1.0d-16)

    temperature = 373.946d0
    call EOSWaterSaturationPressure(temperature, saturation_pressure, ierr)
    value = 22064000.000000000d0
    @assertEqual(value, saturation_pressure, 1.0d-16)

  end subroutine testEOSWater_SatPresWagnerPruss

! ************************************************************************** !

  @Test
  subroutine testEOSWater_ThermCondIF97(this)
    !
    ! verify that the EOSWaterThermalConductivityIF97 returns the correct values
    !
    use PFLOTRAN_constants_module

    implicit none

    class (Test_EOS_Water), intent(inout) :: this

    PetscReal :: temperature
    PetscReal :: liquid_pressure
    PetscReal :: correct_lambda
    PetscReal :: correct_dlambda_dp
    PetscReal :: correct_dlambda_dT

    call EOSWaterInit()
    call EOSWaterSetDensity('IF97')

    temperature = 1.d0
    liquid_pressure = 2.d5
    correct_lambda = 5.5108463730055574d-007
    correct_dlambda_dp = 6.2188777051159803d-016
    correct_dlambda_dT = 2.1845907210765649d-009
    call TestLambda(temperature,liquid_pressure,correct_lambda, &
                    correct_dlambda_dp,correct_dlambda_dT)

    temperature = 35.d0
    liquid_pressure = 5.d6
    correct_lambda = 6.1382745408029005d-007
    correct_dlambda_dp = 5.4248702394014398d-016
    correct_dlambda_dT = 1.4087584609173883d-009
    call TestLambda(temperature,liquid_pressure,correct_lambda, &
                    correct_dlambda_dp,correct_dlambda_dT)

    temperature = 75.d0
    liquid_pressure = 1.d6
    correct_lambda = 6.5483123857959583d-007
    correct_dlambda_dp = 5.4823707725112537d-016
    correct_dlambda_dT = 7.7449202817122260d-010
    call TestLambda(temperature,liquid_pressure,correct_lambda, &
                    correct_dlambda_dp,correct_dlambda_dT)

    temperature = 150.d0
    liquid_pressure = 7.d7
    correct_lambda = 7.1956837322934805d-007
    correct_dlambda_dp = 5.5184664978488887d-016
    correct_dlambda_dT = 1.7641677067122949d-011
    call TestLambda(temperature,liquid_pressure,correct_lambda, &
                    correct_dlambda_dp,correct_dlambda_dT)

    temperature = 15.d0
    liquid_pressure = 5.d7
    correct_lambda = 6.0652403927047784d-007
    correct_dlambda_dp = 5.2646893703377536d-016
    correct_dlambda_dT = 1.7124590721884491d-009
    call TestLambda(temperature,liquid_pressure,correct_lambda, &
                    correct_dlambda_dp,correct_dlambda_dT)

  contains

    subroutine TestLambda(temperature,liquid_pressure,correct_lambda, &
                          correct_dlambda_dp,correct_dlambda_dT)

      PetscReal :: temperature
      PetscReal :: liquid_pressure
      PetscReal :: correct_lambda
      PetscReal :: correct_dlambda_dp
      PetscReal :: correct_dlambda_dT

      PetscBool :: calculate_derivatives
      PetscReal :: lambda
      PetscReal :: dlambda_dp
      PetscReal :: dlambda_dT
!      PetscReal :: dlambda_dp_pert
!      PetscReal :: dlambda_dT_pert
!      PetscReal :: T_pert
!      PetscReal :: p_pert
!      PetscReal :: lambda_pert
!      PetscReal :: pert
!      PetscReal :: dummy
      PetscReal, parameter :: tol = 1.d-6
      PetscReal, parameter :: assertion_tol = 1.d-6

      calculate_derivatives = PETSC_TRUE
      call CalcLambda(temperature,liquid_pressure,lambda, &
                      calculate_derivatives,dlambda_dp,dlambda_dT)
!      print *, 'temperature: ', temperature
!      print *, 'pressure: ', liquid_pressure
!      print *, 'lambda: ', lambda
!      print *, 'dlambda_dp: ', dlambda_dp
!      print *, 'dlambda_dT: ', dlambda_dT
      @assertEqual(correct_lambda, lambda, assertion_tol)
      @assertEqual(correct_dlambda_dp, dlambda_dp, assertion_tol)
      @assertEqual(correct_dlambda_dT, dlambda_dT, assertion_tol)

!      calculate_derivatives = PETSC_FALSE
!      pert = liquid_pressure*tol
!      p_pert = liquid_pressure + pert
!      call CalcLambda(temperature,p_pert,lambda_pert, &
!                      calculate_derivatives,dummy,dummy)
!      dlambda_dp_pert = (lambda_pert-lambda)/pert
!      print *, 'dlambda_dp (pert): ', dlambda_dp_pert

!      pert = temperature*tol
!      T_pert = temperature + pert
!      call CalcLambda(T_pert,liquid_pressure,lambda_pert, &
!                      calculate_derivatives,dummy,dummy)
!      dlambda_dT_pert = (lambda_pert-lambda)/pert
!      print *, 'dlambda_dT (pert): ', dlambda_dT_pert

!      print *
!      print *, 'dlambda_dp (rel diff): ', (dlambda_dp-dlambda_dp_pert) / &
!                                          dlambda_dp
!      print *, 'dlambda_dT (rel diff): ', (dlambda_dT-dlambda_dT_pert) / &
!                                          dlambda_dT
!      print *

    end subroutine TestLambda

    subroutine CalcLambda(temperature,liquid_pressure,lambda, &
                          calculate_derivatives,dlambda_dp,dlambda_dT)

      use EOS_Water_module

      implicit none

      PetscReal :: temperature
      PetscReal :: liquid_pressure
      PetscReal :: lambda
      PetscBool :: calculate_derivatives
      PetscReal :: dlambda_dp
      PetscReal :: dlambda_dT

      PetscReal :: denw_kg
      PetscReal :: denw_kmol
      PetscReal :: ddenw_kmol_dp
      PetscReal :: ddenw_kmol_dt
      PetscReal :: ddenw_kg_dp
      PetscReal :: ddenw_kg_dt

      PetscErrorCode :: ierr

      call EOSWaterDensity(temperature,liquid_pressure, &
                           denw_kg,denw_kmol, &
                           ddenw_kmol_dp,ddenw_kmol_dt,ierr)
      ddenw_kg_dp = ddenw_kmol_dp*FMWH2O
      ddenw_kg_dt = ddenw_kmol_dt*FMWH2O
      call EOSWaterThermalConductivityIF97(denw_kg,temperature,lambda, &
                       calculate_derivatives,ddenw_kg_dp,ddenw_kg_dt, &
                      dlambda_dp,dlambda_dT)

    end subroutine CalcLambda

  end subroutine testEOSWater_ThermCondIF97

  ! ************************************************************************** !

  @Test
  subroutine testEOSWater_DensityIF97(this)
    !
    ! Cover densities calculated by IF97 algorithm

    use PFLOTRAN_Constants_module, only : MAXSTRINGLENGTH

    implicit none

    class (Test_EOS_Water), intent(inout) :: this

    PetscErrorCode :: ierr

    PetscReal :: temperature = 20.0d0
    PetscReal :: pressure = 101325.0d0
    PetscReal :: density
    PetscReal :: dum1
    PetscReal :: correct_density
    PetscReal, parameter :: tol = 1.d-16

    call EOSWaterInit()
    call EOSWaterSetDensity('IF97')

    pressure = 20.d6
    temperature = 200.d0
    correct_density = 877.97408902435325d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, density
    @assertEqual(correct_density, density, tol)

end subroutine testEOSWater_DensityIF97

! ************************************************************************** !

  @Test
  subroutine testEOSWater_DensityIF97_Region3(this)
    !
    ! Exercises EOSWaterDensityIF97() for Region 3 of the IAPWS-IF97 standard,
    ! which spans T > 623.15 K (350 C), pressures above the saturation curve,
    ! and up to 100 MPa. Region 3 is computed via the backward equations
    ! v(p,T) of IAPWS SR5-05(2016), which subdivide Region 3 into 26
    ! sub-regions (3a-3z).
    !
    ! P/T centroid pairs are provided for all 26 sub-regions, derived from
    ! Figures 3, 4, and 5 of IAPWS SR5-05(2016):
    !   Figure 3: full Region 3 overview (3a-3f, 3k, 3q, 3r, 3s, 3t)
    !   Figure 4: enlargement of sub-regions 3c-3r
    !   Figure 5: auxiliary sub-regions 3u-3z (near-critical, 2016 update)
    ! Sub-regions appearing in multiple figures have one pair per figure.
    ! The first three pairs have no associated figure.

    implicit none

    class (Test_EOS_Water), intent(inout) :: this

    PetscErrorCode :: ierr

    PetscReal :: temperature
    PetscReal :: pressure
    PetscReal :: density
    PetscReal :: correct_density
    PetscReal :: dum1
    PetscReal, parameter :: tol = 1.d-16

    call EOSWaterInit()
    call EOSWaterSetDensity('IF97')

    ! Region 3 (30 MPa, 400 C): [no figure]
    pressure = 30.d6
    temperature = 400.d0
    correct_density = 357.59973899020429d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3 (30 MPa, 400 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3 near-critical (23 MPa, 374 C): [no figure]
    pressure = 23.d6
    temperature = 374.d0
    correct_density = 468.89641477622831d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3 near-critical (23 MPa, 374 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3a (50 MPa, 356.85 C): [no figure]
    pressure = 50.d6
    temperature = 356.85d0
    correct_density = 679.87754856320737d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3a (50 MPa, 356.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3a (70 MPa, 386.85 C): [Figure 3]
    pressure = 70.0d6
    temperature = 386.85d0
    correct_density = 663.40112368054167d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3a (70 MPa, 386.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3b (70 MPa, 446.85 C): [Figure 3]
    pressure = 70.0d6
    temperature = 446.85d0
    correct_density = 536.10407765829439d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3b (70 MPa, 446.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3c (24.0 MPa, 366.85 C): [Figure 4]
    pressure = 24.0d6
    temperature = 366.85d0
    correct_density = 548.74127042438977d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3c (24.0 MPa, 366.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3c (33 MPa, 369.85 C): [Figure 3, Figure 4]
    pressure = 33.0d6
    temperature = 369.85d0
    correct_density = 595.45931425287483d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3c (33 MPa, 369.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3d (25.0 MPa, 378.85 C): [Figure 4]
    pressure = 25.0d6
    temperature = 378.85d0
    correct_density = 466.67140063918697d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3d (25.0 MPa, 378.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3d (33 MPa, 391.85 C): [Figure 3, Figure 4]
    pressure = 33.0d6
    temperature = 391.85d0
    correct_density = 499.22200823293110d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3d (33 MPa, 391.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3e (25.2 MPa, 385.35 C): [Figure 4]
    pressure = 25.2d6
    temperature = 385.35d0
    correct_density = 326.36058159308914d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3e (25.2 MPa, 385.35 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3e (33 MPa, 406.85 C): [Figure 3, Figure 4]
    pressure = 33.0d6
    temperature = 406.85d0
    correct_density = 383.00484452231541d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3e (33 MPa, 406.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3f (25.0 MPa, 397.85 C): [Figure 4]
    pressure = 25.0d6
    temperature = 397.85d0
    correct_density = 173.16423830476310d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3f (25.0 MPa, 397.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3f (33 MPa, 426.85 C): [Figure 3, Figure 4]
    pressure = 33.0d6
    temperature = 426.85d0
    correct_density = 237.27658278475144d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3f (33 MPa, 426.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3g (24.0 MPa, 375.85 C): [Figure 4]
    pressure = 24.0d6
    temperature = 375.85d0
    correct_density = 475.46496932538292d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3g (24.0 MPa, 375.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3h (24.0 MPa, 381.85 C): [Figure 4]
    pressure = 24.0d6
    temperature = 381.85d0
    correct_density = 281.66396881478931d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3h (24.0 MPa, 381.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3i (24.0 MPa, 385.85 C): [Figure 4]
    pressure = 24.0d6
    temperature = 385.85d0
    correct_density = 204.11798151543536d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3i (24.0 MPa, 385.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3j (24.0 MPa, 389.85 C): [Figure 4]
    pressure = 24.0d6
    temperature = 389.85d0
    correct_density = 178.82940759277494d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3j (24.0 MPa, 389.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3k (21.3 MPa, 373.85 C): [Figure 3, Figure 4, Figure 5]
    pressure = 21.3d6
    temperature = 373.85d0
    correct_density = 171.61972199514591d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3k (21.3 MPa, 373.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3k (24.5 MPa, 399.85 C): [Figure 3, Figure 4]
    pressure = 24.5d6
    temperature = 399.85d0
    correct_density = 157.43761255120120d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3k (24.5 MPa, 399.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3l (23.0 MPa, 375.35 C): [Figure 4]
    pressure = 23.0d6
    temperature = 375.35d0
    correct_density = 443.09111459660465d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3l (23.0 MPa, 375.35 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3m (22.65 MPa, 371.85 C): [Figure 4]
    pressure = 22.65d6
    temperature = 371.85d0
    correct_density = 487.67852604653564d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3m (22.65 MPa, 371.85 C):', density
    @assertEqual(correct_density, density, tol)

    ! Region 3n (22.7 MPa, 374.85 C): [Figure 4]
    pressure = 22.7d6
    temperature = 374.85d0
    correct_density = 435.26919619420528d0
    call EOSWaterDensity(temperature, pressure, density, dum1, ierr)
    !print *, 'Region 3n (22.7 MPa, 374.85 C):', density
