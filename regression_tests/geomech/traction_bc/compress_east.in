SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS 
        OPTIONS
          DISABLE_CAPILLARITY
      /
    / 
    SUBSURFACE_GEOMECHANICS geomech
      OPTIONS
        FLOW_COUPLING TWO_WAY_COUPLED
        SPLIT_SCHEME FIXED_STRESS
      /
    /
  / 
END

EXTERNAL_FILE subsurface_common.txt

GEOMECHANICS

EXTERNAL_FILE geomechanics_common.txt

GEOMECHANICS_REGION north_geomech
  FILE ../meshes/one_cell_structured/north.vset
END

GEOMECHANICS_REGION south_geomech
  FILE ../meshes/one_cell_structured/south.vset
END

GEOMECHANICS_REGION east_geomech
  FILE ../meshes/one_cell_structured/east.ss
END

GEOMECHANICS_REGION west_geomech
  FILE ../meshes/one_cell_structured/west.vset
END

GEOMECHANICS_REGION top_geomech
  FILE ../meshes/one_cell_structured/top.vset
END

GEOMECHANICS_REGION bottom_geomech
  FILE ../meshes/one_cell_structured/bottom.vset
END

GEOMECHANICS_CONDITION top_geomech
  TYPE
    DISPLACEMENT_Z DIRICHLET
  END
    DISPLACEMENT_Z 0.0
END

GEOMECHANICS_CONDITION east_geomech
  TYPE
    TRACTION NEUMANN
  END
    STRESS_TENSOR -1.d0 0.d0 0.d0 0.d0 0.d0 0.d0
END

GEOMECHANICS_CONDITION west_geomech
  TYPE
    DISPLACEMENT_X DIRICHLET
  END
    DISPLACEMENT_X 0.0
END

GEOMECHANICS_CONDITION north_geomech
  TYPE
    DISPLACEMENT_Y DIRICHLET
  END
    DISPLACEMENT_Y 0.0
END

GEOMECHANICS_CONDITION bottom_geomech
  TYPE
    DISPLACEMENT_Z DIRICHLET
  END
    DISPLACEMENT_Z 0.0
END

GEOMECHANICS_CONDITION south_geomech
  TYPE
    DISPLACEMENT_Y DIRICHLET
  END
    DISPLACEMENT_Y 0.0
END

GEOMECHANICS_REGRESSION
  VARIABLES
    DISPLACEMENT_X
  /
  VERTICES
    3
    6
    9
    12
    15
    18
    21
    24
    27
  /
END

END_GEOMECHANICS
