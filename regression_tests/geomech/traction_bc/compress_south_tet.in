SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE richards
    / 
    SUBSURFACE_GEOMECHANICS geomech
      OPTIONS
        FLOW_COUPLING ONE_WAY_COUPLED
        SPLIT_SCHEME FIXED_STRESS
      /
    /
  / 
END

EXTERNAL_FILE subsurface_common_tet.txt 

GEOMECHANICS

EXTERNAL_FILE geomechanics_common_tet.txt

GEOMECHANICS_REGION north_geomech
  FILE ../meshes/small_tet/ymax.vset
END

GEOMECHANICS_REGION south_geomech
  FILE ../meshes/small_tet/ymin.ss
END

GEOMECHANICS_REGION east_geomech
  FILE ../meshes/small_tet/xmax.vset
END

GEOMECHANICS_REGION top_geomech
  FILE ../meshes/small_tet/zmax.vset
END

GEOMECHANICS_REGION bottom_geomech
  FILE ../meshes/small_tet/zmin.ss
END

GEOMECHANICS_REGION west_geomech
  FILE ../meshes/small_tet/xmin.vset
END

GEOMECHANICS_CONDITION west_geomech
  TYPE
    DISPLACEMENT_X DIRICHLET
  END
    DISPLACEMENT_X 0.0
END

GEOMECHANICS_CONDITION south_geomech
  TYPE
    TRACTION NEUMANN
  END
  STRESS_TENSOR  0. -10.d5 0. 0. 0. 0.
END

GEOMECHANICS_CONDITION bottom_geomech
  TYPE
    DISPLACEMENT_Z DIRICHLET
  END
    DISPLACEMENT_Z 0.0
END

GEOMECHANICS_CONDITION north_geomech
  TYPE
    DISPLACEMENT_Y DIRICHLET
  END
    DISPLACEMENT_Y 0.0
END

GEOMECHANICS_CONDITION top_geomech
  TYPE
    DISPLACEMENT_Z DIRICHLET
  END
    DISPLACEMENT_Z 0.0
END

GEOMECHANICS_CONDITION east_geomech
  TYPE
    DISPLACEMENT_X DIRICHLET
  END
    DISPLACEMENT_X 0.0
END

GEOMECHANICS_REGRESSION
  VARIABLES
    DISPLACEMENT_Y
  /
  VERTICES
    1
    3
    7
    8
    9
    12
  /
END

END_GEOMECHANICS
