# Template for variably-saturated flow in an anisymmetric, 2D cylindrical domain

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
  /
END

SUBSURFACE

#=========================== numerical methods ================================
NUMERICAL_METHODS FLOW

  NEWTON_SOLVER
    # allow the model to converge when the maximum change in below
    # liquid pressure is 1 Pa.
    ITOL_UPDATE 1.d0
  /

END

#=========================== discretization ===================================
GRID
  TYPE STRUCTURED CYLINDRICAL
  NXYZ 100 1 20
  BOUNDS
    0.   0.
    100. 20.
  /
END

#=========================== material properties ==============================
MATERIAL_PROPERTY sand
  ID 1
  POROSITY 0.25d0
  PERMEABILITY
    PERM_ISO 1.d-12
  /
  CHARACTERISTIC_CURVES cc_well_behaved
END

#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES cc_well_behaved
  SATURATION_FUNCTION VAN_GENUCHTEN
    ALPHA 1.d-4
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
END

#=========================== output options ===================================
OUTPUT
  SNAPSHOT_FILE
    PERIODIC TIME 0.01 y BETWEEN 0. y AND 0.1 y
    PERIODIC TIME 0.1 y BETWEEN 0. y AND 1. y
    PERIODIC TIME 1 y
    FORMAT HDF5
  /
  PRINT_COLUMN_IDS
  OBSERVATION_FILE
    # outputing observation every time step is cheap
    PERIODIC TIMESTEP 1
  /
  CONSERVATION_FILE
    PERIODIC TIMESTEP 1
  /
  MASS_BALANCE_FILE
    PERIODIC TIMESTEP 1
  /
END

#=========================== times ============================================
TIME
  FINAL_TIME 1.d0 h
  INITIAL_TIMESTEP_SIZE 1.d0 h
  MAXIMUM_TIMESTEP_SIZE 5.d-2 y
END

#=========================== regions ==========================================
REGION all
  INFINITE
END

REGION pump_location
  COORDINATES
    0. 0. 2.
    0. 1. 6.
  /
END

REGION east
  FACE EAST
  COORDINATES
    100. 0. -1.d20
    100. 1.  1.d20
  /
END

#=========================== flow conditions ==================================
FLOW_CONDITION initial_pressure
  TYPE
    LIQUID_PRESSURE HYDROSTATIC
  /
  DATUM 0.d0 0.d0 40.d0
  LIQUID_PRESSURE 101325.d0
END

FLOW_CONDITION pumping_well
  TYPE
    RATE SCALED_MASS_RATE NEIGHBOR_PERM
  /
  RATE LIST
    TIME_UNITS d
    DATA_UNITS kg/min
    0. 10.
    # add additional times here
  /
END

#=========================== condition couplers ===============================
# initial condition
INITIAL_CONDITION
  FLOW_CONDITION initial_pressure
  REGION all
END

BOUNDARY_CONDITION east
  FLOW_CONDITION initial_pressure
  REGION east
END

SOURCE_SINK well
  FLOW_CONDITION pumping_well
  REGION pump_location
END

#=========================== stratigraphy couplers ============================
STRATA
  REGION all
  MATERIAL sand
END

END_SUBSURFACE
