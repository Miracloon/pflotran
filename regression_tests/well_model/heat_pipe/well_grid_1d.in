#Description: test problem for 1D geothermal heat pipe
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
    WELL_MODEL well
      TYPE CLOSED_LOOP_U_SHAPE
    END
  /
END

SUBSURFACE

EXTERNAL_FILE heat_pipe_1d.txt

#=========================== well model =======================================
WELLBORE_MODEL well

  WELL_GRID
    WELL_TRAJECTORY
      SURFACE_ORIGIN         0. 2.5 2.5
      SEGMENT_DXYZ UNCASED  20. 0.  0.
    /
  /

  WELL
    SCENARIO 4
    USE_WELL_INDEX
    INLET_TEMPERATURE 5.
    PIPE_INNER_DIAMETER 0.1
    PIPE_WALL_THICKNESS 0. # placeholder
    PIPE_WALL_THERMAL_CONDUCTIVITY 0. # placeholder
    PIPE_FLOW_VELOCITY 1.574074d-5 # 1 m/d
  /

END

#=========================== numerical methods ================================
NUMERICAL_METHODS FLOW

  NEWTON_SOLVER
#    NUMERICAL_JACOBIAN
  /

END

END_SUBSURFACE
