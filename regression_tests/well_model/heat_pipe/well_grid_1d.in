#Description: 1D heat pipe via WELL_TRAJECTORY; no well index (fluid+wall only)
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE TH
    /
    WELL_MODEL well
      TYPE CLOSED_LOOP_U_SHAPE
    END
  /
END

SUBSURFACE

EXTERNAL_FILE heat_pipe_1d.txt

#=========================== well model =======================================
WELLBORE_MODEL well

  WELL_GRID
    WELL_TRAJECTORY
      SURFACE_ORIGIN         0.  2.5  2.5
      SEGMENT_DXYZ UNCASED  20.  0.   0.
    /
  /

  WELL
    INLET_TEMPERATURE 5.
    PIPE_INNER_DIAMETER 0.1
    PIPE_WALL_THICKNESS 5.d-3
    PIPE_WALL_THERMAL_CONDUCTIVITY 40.
    PIPE_FLOW_VELOCITY 1.574074d-5 # 1 m/d
  /

END

#=========================== numerical methods ================================
NUMERICAL_METHODS FLOW

  NEWTON_SOLVER
#    NUMERICAL_JACOBIAN
  /

END

END_SUBSURFACE
