# Tests SCALED_VOLUMETRIC_RATE NEIGHBOR_PERM_{XY,XZ,YZ,XYZ} with anisotropic
# permeability. Three well cells are spaced along X with a skipped cell
# between them. High-kx neighbors of well 1, high-ky neighbors of well 2,
# and high-kz neighbors of well 3 make each direction weight a different
# pair of wells, so a swapped direction is visible in well pressures.
# Each (material, component) uses a unique 1..12 coefficient so a wrong
# kx/ky/kz lookup cannot hide behind a repeated value.

SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
  /
END

SUBSURFACE

#=========================== numerical methods ================================
NUMERICAL_METHODS FLOW
  NEWTON_SOLVER
    ATOL 1.d-12
    RTOL 1.d-8
  /
END

#=========================== regression =======================================
# natural ids on a 7x5x5 grid: id = i + (j-1)*7 + (k-1)*35
# wells (2,3,3)=86, (4,3,3)=88, (6,3,3)=90
# high-kx neighbor (1,3,3)=85; high-ky (4,2,3)=81; high-kz (6,3,2)=55
REGRESSION
  CELL_IDS
    86
    88
    90
    85
    81
    55
  /
  VARIABLES
    LIQUID_PRESSURE
  /
END

#=========================== discretization ===================================
GRID
  TYPE STRUCTURED
  NXYZ 7 5 5
  BOUNDS
    0.d0 0.d0 0.d0
    7.d0 5.d0 5.d0
  /
END

#=========================== material properties ==============================
MATERIAL_PROPERTY soil_base
  ID 1
  POROSITY 0.25d0
  PERMEABILITY
    PERM_X 1.d-15
    PERM_Y 2.d-15
    PERM_Z 3.d-15
  /
  CHARACTERISTIC_CURVES cc1
END

MATERIAL_PROPERTY soil_x
  ID 2
  POROSITY 0.25d0
  PERMEABILITY
    PERM_X 4.d-10
    PERM_Y 5.d-15
    PERM_Z 6.d-15
  /
  CHARACTERISTIC_CURVES cc1
END

MATERIAL_PROPERTY soil_y
  ID 3
  POROSITY 0.25d0
  PERMEABILITY
    PERM_X 7.d-15
    PERM_Y 8.d-10
    PERM_Z 9.d-15
  /
  CHARACTERISTIC_CURVES cc1
END

MATERIAL_PROPERTY soil_z
  ID 4
  POROSITY 0.25d0
  PERMEABILITY
    PERM_X 10.d-15
    PERM_Y 11.d-15
    PERM_Z 12.d-10
  /
  CHARACTERISTIC_CURVES cc1
END

#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES cc1
  SATURATION_FUNCTION VAN_GENUCHTEN
    ALPHA 1.d-4
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
END

EOS WATER
  DENSITY CONSTANT 1000.d0
  VISCOSITY CONSTANT 1.d-3
END

#=========================== times ============================================
TIME
  FINAL_TIME 1.d0 d
  INITIAL_TIMESTEP_SIZE 1.d-2 d
  MAXIMUM_TIMESTEP_SIZE 1.d-1 d
END

#=========================== regions ==========================================
REGION all
  COORDINATES
    -1.d20 -1.d20 -1.d20
     1.d20  1.d20  1.d20
  /
END

REGION west
  FACE WEST
  COORDINATES
    0.d0 0.d0 0.d0
    0.d0 5.d0 5.d0
  /
END

! wells at i=2,4,6 (j=3,k=3), separated by one cell in X
REGION wells
  LIST
    86
    88
    90
  /
END

! X-neighbors of well 1 (i=2,j=3,k=3), excluding the shared separator
REGION high_kx
  BLOCK 1 1 3 3 3 3
END

! Y-neighbors of well 2 (i=4,j=3,k=3)
REGION high_ky_s
  BLOCK 4 4 2 2 3 3
END
REGION high_ky_n
  BLOCK 4 4 4 4 3 3
END

! Z-neighbors of well 3 (i=6,j=3,k=3)
REGION high_kz_b
  BLOCK 6 6 3 3 2 2
END
REGION high_kz_t
  BLOCK 6 6 3 3 4 4
END

#=========================== flow conditions ==================================
FLOW_CONDITION initial
  TYPE
    LIQUID_PRESSURE DIRICHLET
  /
  LIQUID_PRESSURE 1.d5
END

FLOW_CONDITION scale_xy
  TYPE
    RATE SCALED_VOLUMETRIC_RATE NEIGHBOR_PERM_XY
  /
  RATE 1.d0 m^3/day
END

FLOW_CONDITION scale_xz
  TYPE
    RATE SCALED_VOLUMETRIC_RATE NEIGHBOR_PERM_XZ
  /
  RATE 2.d0 m^3/day
END

FLOW_CONDITION scale_yz
  TYPE
    RATE SCALED_VOLUMETRIC_RATE NEIGHBOR_PERM_YZ
  /
  RATE 4.d0 m^3/day
END

FLOW_CONDITION scale_xyz
  TYPE
    RATE SCALED_VOLUMETRIC_RATE NEIGHBOR_PERM_XYZ
  /
  RATE 8.d0 m^3/day
END

#=========================== condition couplers ===============================
INITIAL_CONDITION
  FLOW_CONDITION initial
  REGION all
END

BOUNDARY_CONDITION west
  FLOW_CONDITION initial
  REGION west
END

SOURCE_SINK ss_xy
  FLOW_CONDITION scale_xy
  REGION wells
END

SOURCE_SINK ss_xz
  FLOW_CONDITION scale_xz
  REGION wells
END

SOURCE_SINK ss_yz
  FLOW_CONDITION scale_yz
  REGION wells
END

SOURCE_SINK ss_xyz
  FLOW_CONDITION scale_xyz
  REGION wells
END

#=========================== stratigraphy =====================================
STRATA
  REGION all
  MATERIAL soil_base
END

STRATA
  REGION high_kx
  MATERIAL soil_x
END

STRATA
  REGION high_ky_s
  MATERIAL soil_y
END

STRATA
  REGION high_ky_n
  MATERIAL soil_y
END

STRATA
  REGION high_kz_b
  MATERIAL soil_z
END

STRATA
  REGION high_kz_t
  MATERIAL soil_z
END

END_SUBSURFACE
