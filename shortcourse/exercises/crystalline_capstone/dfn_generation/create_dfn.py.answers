#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
DFN generating script for PFLOTRAN Advanced Short Course Practice Problem
Summer 2023
"""

import os, sys
from pydfnworks import * 

src_path = os.getcwd()

jobname = f"{src_path}/output"   
        
#dfnFlow_file = f"{src_path}/dfn_explicit.in"
DFN = DFNWORKS(jobname)
#               dfnFlow_file=dfnFlow_file)

DFN.params['domainSize']['value'] = [1000.0, 1000.0, 500.0]
DFN.params['h']['value'] = 1.0
DFN.params['seed']['value'] = 20201153 #seed for random generator 0 seeds off clock

DFN.add_fracture_family(shape="ell",
                        distribution="tpl",
                        p32 = 0.00769494,
                        beta_distribution = 1,
                        beta = 0,
                        number_of_points = 12,
                        kappa=22,
                        theta=90,
                        phi=0,
                        alpha=2.5,
                        min_radius=30.0,
                        max_radius=500.0,
                        hy_variable='permeability',
                        hy_function='semi-correlated',
                        hy_params={
                            "alpha": 1e-13,
                            "beta": 0.9,
                            "sigma": 1.0
                        })


DFN.add_fracture_family(shape="ell",
                        distribution="tpl",
                        p32 = 0.0055714,
                        beta_distribution = 1,
                        beta = 0,
                        number_of_points = 12,
                        kappa=22,
                        theta=180,
                        phi=90,
                        alpha=2.7,
                        min_radius=30.0,
                        max_radius=500.0,
                        hy_variable='permeability', #you can play around with this
                        hy_function='semi-correlated',
                        hy_params={
                            "alpha": 1e-13,
                            "beta": 0.9,
                            "sigma": 1.0
                        })


DFN.add_fracture_family(shape="ell",
                        distribution="tpl",
                        p32 = 0.03376919,
                        beta_distribution = 1,
                        beta = 0,
                        number_of_points = 12,
                        kappa=10,
                        theta=0,
                        phi=360,
                        alpha=2.4,
                        min_radius=30.0,
                        max_radius=500.0,
                        hy_variable='permeability',
                        hy_function='semi-correlated',
                        hy_params={
                            "alpha": 1e-13,
                            "beta": 0.9,
                            "sigma": 1.0
                        })

DFN.add_user_fract(shape='ell',
                    radii=200,
                    translation=[500, 500, 250],
                    aspect_ratio=1,
                    beta=0,
                    normal_vector=[0, 0, 1],
                    number_of_vertices=5,
                    aperture=1.0e-3)

DFN.add_user_fract(shape='ell',
                    radii=1000,
                    translation=[-200, -350, 200],
                    aspect_ratio=1,
                    beta=0,
                    normal_vector=[1, 1, -1],
                    number_of_vertices=5,
                    aperture=4.0e-3)

#Question 3
#DFN.add_user_fract(shape='ell',
#                    radii=500,
#                    translation=[-200, -350, 200],
#                    normal_vector=[1, 1, 1],
#                    number_of_vertices=5,
#                    aperture=2.0e-3)

DFN.make_working_directory(delete=True)
DFN.print_domain_parameters()
DFN.check_input()
DFN.create_network()
DFN.dump_hydraulic_values()


