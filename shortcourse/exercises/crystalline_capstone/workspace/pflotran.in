#Crystalline Capstone Problem for the PFLOTRAN Advanced Short Course
#Summer 2023
#Authors: Teresa Portone, Ethan Conley, Michael Nole

#=========================== flow mode ========================================
SIMULATION
...
END

SUBSURFACE

#=========================== datasets =========================================
DATASET permeabilityX
  FILENAME cpm/anisotropic_k.h5
  HDF5_DATASET_NAME PermeabilityX
END

DATASET permeabilityY
  FILENAME cpm/anisotropic_k.h5
  HDF5_DATASET_NAME PermeabilityY
END

DATASET permeabilityZ
  FILENAME cpm/anisotropic_k.h5
  HDF5_DATASET_NAME PermeabilityZ
END

DATASET porosity
  FILENAME cpm/porosity.h5
  HDF5_DATASET_NAME Porosity
END

DATASET tortuosity
  FILENAME cpm/tortuosity.h5
  HDF5_DATASET_NAME Tortuosity 
END
 
#=========================== chemistry ========================================
CHEMISTRY
  PRIMARY_SPECIES
    I129
    Tracer1     # repository residence time, one early pulse
    Tracer2     # constant repository injection, no decay
    Tracer3     # constant repository injection, ingrows
    Tracer4     # constant repository injection, sorbs
  /
  MINERALS
    I129(s)
    Tracer3(s)
    Tracer4(s)
  /
  MINERAL_KINETICS
    I129(s)
      RATE_CONSTANT 0.d0
    /
    Tracer3(s)
      RATE_CONSTANT 0.d0
    /
    Tracer4(s)
      RATE_CONSTANT 0.d0
    /
  /
  TRUNCATE_CONCENTRATION 1.d-22 
  DATABASE ufd-decay.dat
  OUTPUT
    TOTAL
    TOTAL_SORBED
    all
  /

END

#=========================== discretization ===================================
GRID
...
END

#=========================== times ============================================

TIME
  FINAL_TIME ... y
  INITIAL_TIMESTEP_SIZE 1.d-6 y
  MAXIMUM_TIMESTEP_SIZE 1. y at 1. y
  MAXIMUM_TIMESTEP_SIZE 5. y at 10. y
  MAXIMUM_TIMESTEP_SIZE 50. y at 100. y
  MAXIMUM_TIMESTEP_SIZE 500. y at 1000. y
  MAXIMUM_TIMESTEP_SIZE 5000. y at 10000. y
END

#=========================== output options ===================================
OUTPUT
  SNAPSHOT_FILE
    FORMAT HDF5
    TIMES y 0 500.0 1000.0 5000.0 7500.0 10000.0 100000.0 1000000.0
  /
  VARIABLES
    LIQUID_PRESSURE
    PERMEABILITY_X
    PERMEABILITY_Y
    PERMEABILITY_Z
    POROSITY
  /
  OBSERVATION_FILE
    PERIODIC TIME 1. y between 0. y and 10. y
    PERIODIC TIME 5. y between 0. y and 30. y
    PERIODIC TIME 10. y between 0. y and 100. y
    PERIODIC TIME 50. y between 0. y and 300. y
    PERIODIC TIME 100. y between 0. y and 1000. y
    PERIODIC TIME 500. y between 0. y and 3000. y
    PERIODIC TIME 1000. y between 0. y and 10000. y
    PERIODIC TIME 5000. y between 0. y and 30000. y
    PERIODIC TIME 10000. y between 0. y and 100000. y
    PERIODIC TIME 100000. y between 0. y and 1000000. y
  /  
  MASS_BALANCE_FILE
    TIMES y 1 100 1000 3000 9999 10000 29999 30000 99999 100000 1000000
    NO_PRINT_FINAL
    TOTAL_MASS_REGIONS
      repository_tight
    /
  /  
END
 

#=========================== observation points ===============================
OBSERVATION
 REGION glacial_obs
 AT_CELL_CENTER
 AGGREGATE_METRICS AGGREGATE_ONLY
  MAX Total I129
  MAX Total Tracer2
  MAX Total Tracer3
  MAX Total Tracer4
 /
/
OBSERVATION
 REGION repo_obs
 AT_CELL_CENTER
 AGGREGATE_METRICS AGGREGATE_ONLY
  MAX Total Tracer1
 /
/

OBSERVATION
 REGION glacial_obs
/

OBSERVATION
 REGION repo_obs
/
#=========================== fluid properties =================================
FLUID_PROPERTY
  PHASE LIQUID
  DIFFUSION_COEFFICIENT 1.d-9
END

#=========================== material properties ==============================
MATERIAL_PROPERTY granite #These come from datasets
  ID 1
  CHARACTERISTIC_CURVES default
  POROSITY ...
  TORTUOSITY ...
  ROCK_DENSITY 2700.
  THERMAL_CONDUCTIVITY_DRY 2.5d0
  THERMAL_CONDUCTIVITY_WET 2.5d0
  HEAT_CAPACITY 830.
  PERMEABILITY
    ...
  /
/

MATERIAL_PROPERTY glacial
  ID 2
  CHARACTERISTIC_CURVES default
  POROSITY 0.2
  TORTUOSITY 0.2
  ROCK_DENSITY 2700.
  THERMAL_CONDUCTIVITY_DRY 1.7d0
  THERMAL_CONDUCTIVITY_WET 1.7d0
  HEAT_CAPACITY 830.
  PERMEABILITY #This is sampled
    ...
  /
/

MATERIAL_PROPERTY drz
  ID 3
  CHARACTERISTIC_CURVES default
  POROSITY 0.2
  TORTUOSITY 0.2
  ROCK_DENSITY 2700.
  THERMAL_CONDUCTIVITY_DRY 2.5d0
  THERMAL_CONDUCTIVITY_WET 2.5d0
  HEAT_CAPACITY 830.
  PERMEABILITY #This is sampled
    ... 
  /
/

MATERIAL_PROPERTY buffer 
  ID 4
  CHARACTERISTIC_CURVES default
  POROSITY ... #This is sampled 
  TORTUOSITY 0.35
  ROCK_DENSITY 2700.
  THERMAL_CONDUCTIVITY_DRY 1.5d0 
  THERMAL_CONDUCTIVITY_WET 1.5d0 
  HEAT_CAPACITY 830.
  PERMEABILITY #This is sampled
    ...
  /                  
/

#=========================== characteristic curves ============================
CHARACTERISTIC_CURVES default
  SATURATION_FUNCTION VAN_GENUCHTEN
    M 0.5d0
    ALPHA  1.d-4
    LIQUID_RESIDUAL_SATURATION 0.1d0
    MAX_CAPILLARY_PRESSURE 1.d8 
  /
  PERMEABILITY_FUNCTION MUALEM_VG_LIQ
    M 0.5d0
    LIQUID_RESIDUAL_SATURATION 0.1d0
  /
END

#=========================== flow conditions ==================================

FLOW_CONDITION initial 
...
END

FLOW_CONDITION inject_repos     # slow injection of age tracers
...
END

FLOW_CONDITION recharge
...
END

#=========================== transport conditions and constraints =============================

TRANSPORT_CONDITION initial
...
END

TRANSPORT_CONDITION init_repos
...
END

TRANSPORT_CONDITION inject_repos   # for age tracers 2 and 3
...
END

CONSTRAINT initial
  CONCENTRATIONS    
    ...
   /
  MINERALS
    ...
   /
END
CONSTRAINT init_repos
  CONCENTRATIONS
    ...
   /
END

CONSTRAINT inject_repos
  CONCENTRATIONS
    ...
   /
END

#=========================== regions ==========================================

REGION all
...
END

REGION glacial
...
END

REGION repo_obs # Observation Point 1
...
END

REGION glacial_obs # Observation Point 2
...
END

REGION west # left
...
END

REGION east # right
...
END

REGION top 
...
END

REGION bottom 
...
END

REGION south # back
...
END

REGION north # front
...
END

REGION repository_tight  
...
END

REGION leak #waste package
...
END


#======================= boundary condition couplers ===================================

BOUNDARY_CONDITION top
...
END

BOUNDARY_CONDITION west
...
END

BOUNDARY_CONDITION east
...
END

#============================= initial condition couplers ==================================
INITIAL_CONDITION
...
END

INITIAL_CONDITION all
...
END

INITIAL_CONDITION
...
END

SOURCE_SINK inject_repos
...
END

#=========================== stratigraphy couplers ============================
STRATA
...
END

STRATA
...
END

STRATA
...
END

STRATA 
...
END

END_SUBSURFACE

#=========================== waste form and UFD spec ============================
WASTE_FORM_GENERAL
  WASTE_FORM
    REGION leak
    EXPOSURE_FACTOR 1.d0
    VOLUME 0.685d0 m^3 
    MECHANISM_NAME csnf
    CANISTER_BREACH_TIME {wpBreachTime} y
  /
  PRINT_MASS_BALANCE
  MECHANISM CUSTOM
    NAME csnf
    FRACTIONAL_DISSOLUTION_RATE {rateUNF} 1/y 
    MATRIX_DENSITY 10970. #
    SEED 1
    SPECIES
      I129   128.90d0  1.29d-15  2.17d-4  0.10d0 #Johnson et al 2005 IRF
    /
    CANISTER_DEGRADATION_MODEL
      CANISTER_MATERIAL_CONSTANT 1500.
    /
  END

END_WASTE_FORM_GENERAL

UFD_DECAY
  ELEMENT I
    SOLUBILITY ...
    KD 
      ...
    /
  /
  ISOTOPE I129
    ELEMENT I
    DECAY_RATE ...
  /
  ELEMENT Tracer
    SOLUBILITY ...
    KD
      ...
    /
  /
  ISOTOPE Tracer3
        ELEMENT Tracer
        DECAY_RATE 2.2e-13 # [1/s]
  /
  ELEMENT Tracer4
    SOLUBILITY ...
    KD
      ...
    /
  /  
END
